# dsh-win7 tracks only its own files. Third-party checkouts (node/, ripgrep/, patches/, e/), toolchains
# (depot_tools/, tools/), build output (out/), local editor settings and HANDOFF.md (the local development log,
# which records this machine's and the test VMs' setup) stay untracked.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/LICENSE
!/README.md
!/CLAUDE.md
!/docs/
!/scripts/
!/shim/
!/win7-fixes/
!/deepseek-harness
