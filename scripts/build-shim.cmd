@echo off
rem Builds a shim DLL into out\shim (x64, static CRT, Windows 7 subsystem version).
rem Usage: build-shim.cmd [name] [def] [outdir]   defaults: dshw7, shim\<name>.def, out\shim
rem   dshw7: shim\dshw7.c + shim\dshw7.def
rem   dshlo: shim\dshlo.c + out\shim\dshlo.def (generated by gen-forward-def.ps1)
rem   dsho:  shim\dsho.c + out\shim\dsho.def (generated by gen-forward-def.ps1); build-win7-python-wheels.ps1 builds
rem          another dsho.dll, for the onnxruntime wheel, into its own outdir
rem   dshmu: shim\dshmu.c + a .def generated by build-win7-python-wheels.ps1, for PyMuPDF's mupdfcpp64.dll
rem /Brepro replaces the timestamps in the output with a hash of the inputs, so the same sources give the same bytes:
rem the patched Python wheels that carry these DLLs are locked by SHA-256.
setlocal
set NoDefaultCurrentDirectoryInExePath=
set "ROOT=%~dp0.."
set "NAME=%~1"
if "%NAME%"=="" set "NAME=dshw7"
set "DEF=%~2"
if "%DEF%"=="" set "DEF=%ROOT%\shim\%NAME%.def"
set "OUTDIR=%~3"
if "%OUTDIR%"=="" set "OUTDIR=%ROOT%\out\shim"
for /f "usebackq tokens=*" %%i in (`"%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe" -latest -property installationPath`) do set "VS=%%i"
call "%VS%\VC\Auxiliary\Build\vcvars64.bat" > nul || exit /b 1
if not exist "%OUTDIR%" mkdir "%OUTDIR%"
cd /d "%OUTDIR%" || exit /b 1
rem link.exe resolves "name = dll.export" forwarders against import libraries, so every forwarded DLL's .lib is listed.
cl /nologo /O2 /W4 /MT /LD /Brepro "%ROOT%\shim\%NAME%.c" /link /Brepro /DEF:"%DEF%" /OUT:%NAME%.dll /SUBSYSTEM:WINDOWS,6.01 kernel32.lib user32.lib bcrypt.lib version.lib winmm.lib shlwapi.lib
